# ————— Public site —————
# Canonical origin used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.guildbournecentre.co.uk

# ————— CMS auth —————
# Editor password for /admin, and a long random string that signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ————— CMS publishing target —————
# Fine-grained GitHub PAT (Contents: read/write on this one repo) + "owner/name".
# Leave empty in development to edit the local files directly (no draft/publish).
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_DRAFT_BRANCH=cms-draft

# ————— Form delivery (optional) —————
# Webhook that receives contact-form submissions as JSON (Zapier/Make/email service).
CONTACT_WEBHOOK_URL=
# Newsletter provider endpoint that accepts {"email": "..."} — can also be set in Site settings.
NEWSLETTER_ENDPOINT=
